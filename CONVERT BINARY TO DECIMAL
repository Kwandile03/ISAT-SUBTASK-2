int hexadecimalToDecimal(string hexadecimal) {
    int decimal = 0;

    for (char digit : hexadecimal) {
        int value;

        if (digit >= '0' && digit <= '9') {
            value = digit - '0';
        }
        else if (digit >= 'A' && digit <= 'F') {
            value = digit - 'A' + 10;
        }
        else if (digit >= 'a' && digit <= 'f') {
            value = digit - 'a' + 10;
        }
        else {
            return -1;
        }

        decimal = decimal * 16 + value;
    }

    return decimal;
}

